NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
APP_RATE_LIMIT_HASH_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000
WOMPI_PUBLIC_KEY=pub_test_replace-with-your-wompi-public-key
WOMPI_INTEGRITY_SECRET=replace-with-your-wompi-integrity-secret
WOMPI_EVENTS_SECRET=replace-with-your-wompi-events-secret
RESEND_API_KEY=re_replace-with-your-resend-api-key
# Correo emisor central verificado en Resend; las profesionales son destinatarias.
NOTIFICATION_FROM_EMAIL=Agenda Clara <citas@your-verified-domain.com>
WHATSAPP_ACCESS_TOKEN=replace-with-your-whatsapp-cloud-api-token
# El PHONE_NUMBER_ID identifica en Meta el número central que envía mensajes.
WHATSAPP_PHONE_NUMBER_ID=replace-with-your-whatsapp-business-phone-number-id
WHATSAPP_CONFIRMATION_TEMPLATE=appointment_confirmed
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_GRAPH_API_VERSION=vXX.X
